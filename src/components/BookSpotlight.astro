---
import bookData from '../data/book.json';
import { socialLinks } from '../data/network';
---

<section class="card" style="padding: 2.75rem 2rem; margin: 4rem 0; border: 1px solid var(--border-highlight); background: radial-gradient(circle at top right, rgba(245, 158, 11, 0.09), transparent 60%), var(--bg-card);">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 3rem; align-items: center;">
    
    <!-- 3D Book Cover Presentation -->
    <div class="book-cover-wrapper">
      <a href="/book" style="display: block; text-decoration: none;" aria-label="Explore Reputation as Code by Alex Merced">
        <picture>
          <source srcset="/images/book-cover.webp" type="image/webp" />
          <img
            src="/images/book-cover.png"
            alt="Reputation as Code book cover by Alex Merced"
            class="book-cover-3d"
            width="310"
            height="465"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </a>
    </div>

    <!-- Book Narrative & Specs -->
    <div>
      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.85rem;">
        <span class="badge badge-amber">The Companion Book</span>
        <span class="badge badge-cyan">{bookData.amazonStatus}</span>
      </div>
      
      <h2 style="margin-bottom: 0.5rem; font-size: clamp(1.8rem, 3vw, 2.3rem);">
        <a href="/book" style="color: #ffffff; text-decoration: none;">{bookData.title}</a>
      </h2>
      
      <p style="color: var(--amber); font-weight: 600; font-size: 1.05rem; line-height: 1.4; margin-bottom: 1.25rem;">
        {bookData.subtitle}
      </p>
      
      <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.65; margin-bottom: 1.5rem;">
        {bookData.synopsis}
      </p>

      <!-- Key Specs Badges -->
      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2rem; font-size: 0.85rem;">
        <span style="background: var(--bg-subtle); padding: 0.35rem 0.75rem; border-radius: 4px; border: 1px solid var(--border); color: var(--text-main);">
          📖 <strong>{bookData.pageCount} Pages</strong>
        </span>
        <span style="background: var(--bg-subtle); padding: 0.35rem 0.75rem; border-radius: 4px; border: 1px solid var(--border); color: var(--text-main);">
          📐 <strong>{bookData.trimSize} Trade Paperback</strong>
        </span>
        <span style="background: var(--bg-subtle); padding: 0.35rem 0.75rem; border-radius: 4px; border: 1px solid var(--border); color: var(--text-main);">
          ⚡ <strong>14 Actionable Chapters</strong>
        </span>
      </div>

      <div style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: center;">
        <a href="/book" class="btn btn-primary">
          Explore All 14 Chapters &rarr;
        </a>
        <a href={socialLinks.substack} target="_blank" rel="noopener" class="btn btn-secondary">
          Get Release Alert on Substack ↗
        </a>
      </div>
    </div>

  </div>
</section>
